# cmake -DPNG_DIR=... -DNAV_TTF=... -DOUT=... -P embed_assets.cmake
#
# Writes a C file with every PNG in PNG_DIR as an image descriptor named after
# the file (what LV_IMG_DECLARE in src/icons.h expects), for grumpy_icons.c to
# decode, and the nav bar font as grumpy_nav_ttf.
file(GLOB pngs ${PNG_DIR}/*.png)
list(SORT pngs)

function(hex_array path var out)
  file(READ ${path} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()

# The descriptor points at {png, size}, not the PNG itself: LVGL's PNG decoder
# claims any image whose data starts with the PNG signature.
set(c "/* generated by embed_assets.cmake: do not edit */\n#include <stddef.h>\n#include \"lvgl/lvgl.h\"\n\ntypedef struct {\n  const uint8_t *png;\n  size_t size;\n} grumpy_icon_src_t;\n\n")
foreach(png ${pngs})
  get_filename_component(name ${png} NAME_WE)
  hex_array(${png} png_${name} hex)
  string(APPEND c "static const uint8_t png_${name}[] = {\n${hex}};\n")
  string(APPEND c "static const grumpy_icon_src_t src_${name} = {png_${name}, sizeof(png_${name})};\n")
  string(APPEND c "const lv_img_dsc_t ${name} = {\n  .header = {.cf = LV_IMG_CF_USER_ENCODED_0},\n  .data_size = sizeof(src_${name}),\n  .data = (const uint8_t *)&src_${name},\n};\n\n")
endforeach()
hex_array(${NAV_TTF} nav hex)
string(APPEND c "const uint8_t grumpy_nav_ttf[] = {\n${hex}};\nconst size_t grumpy_nav_ttf_size = sizeof(grumpy_nav_ttf);\n")

# only touch the output when it changes, so a reconfigure rebuilds nothing
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT old STREQUAL c)
  file(WRITE ${OUT} "${c}")
endif()
