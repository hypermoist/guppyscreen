# cmake -DSVG_DIR=... -DOVERRIDE_DIR=... -DNAV_TTF=... -DOUT=... -P embed_assets.cmake
#
# Writes a C file with every SVG in SVG_DIR as an image descriptor named after
# the file (what LV_IMG_DECLARE in src/icons.h expects), for grumpy_icons.c to
# draw, and the nav bar font as grumpy_nav_ttf. An SVG of the same name in
# OVERRIDE_DIR is used instead, for icons nanosvg cannot draw as they are.
file(GLOB svgs ${SVG_DIR}/*.svg)
list(SORT svgs)

function(hex_array path out)
  file(READ ${path} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()

# The descriptor points at {svg, size} rather than at the text itself, so no
# other decoder mistakes it for an image it knows.
set(c "/* generated by embed_assets.cmake: do not edit */\n#include <stddef.h>\n#include \"lvgl/lvgl.h\"\n\ntypedef struct {\n  const char *svg;\n  size_t size;\n} grumpy_icon_src_t;\n\n")
foreach(svg ${svgs})
  get_filename_component(name ${svg} NAME_WE)
  if(EXISTS ${OVERRIDE_DIR}/${name}.svg)
    set(svg ${OVERRIDE_DIR}/${name}.svg)
  endif()
  hex_array(${svg} hex)
  # NUL-terminated: nanosvg parses a C string
  string(APPEND c "static const char svg_${name}[] = {\n${hex}0x00};\n")
  string(APPEND c "static const grumpy_icon_src_t src_${name} = {svg_${name}, sizeof(svg_${name}) - 1};\n")
  string(APPEND c "const lv_img_dsc_t ${name} = {\n  .header = {.cf = LV_IMG_CF_USER_ENCODED_0},\n  .data_size = sizeof(src_${name}),\n  .data = (const uint8_t *)&src_${name},\n};\n\n")
endforeach()
hex_array(${NAV_TTF} hex)
string(APPEND c "const uint8_t grumpy_nav_ttf[] = {\n${hex}};\nconst size_t grumpy_nav_ttf_size = sizeof(grumpy_nav_ttf);\n")

# only touch the output when it changes, so a reconfigure rebuilds nothing
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT old STREQUAL c)
  file(WRITE ${OUT} "${c}")
endif()
